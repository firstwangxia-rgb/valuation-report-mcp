# Absolute directory used as the MCP server's data boundary.
VALUATION_MCP_WORKSPACE_ROOT=C:\path\to\valuation-workspace

# Paths below the workspace root. Absolute paths and path traversal are rejected.
VALUATION_MCP_KNOWLEDGE_DIR=knowledge-base
VALUATION_MCP_REPORTS_DIR=reports

# Optional extraction safety limits.
VALUATION_MCP_MAX_FILE_BYTES=26214400
VALUATION_MCP_MAX_EXTRACTED_CHARS=200000
